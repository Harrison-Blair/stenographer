# Ignore everything unless an approved path below allows it.
# This keeps recordings, models, and build output out of git.
*

# Root files.
!/.gitignore
!/LICENSE
!/README.md
!/SPEC.md

# Bundled assets: additions require an explicit path.
!/assets/
!/assets/fonts/
!/assets/fonts/Caveat-OFL.txt
!/assets/fonts/Caveat-wght.ttf
!/assets/icons/
!/assets/icons/stenographer.png
!/assets/licenses/
!/assets/licenses/asd-ste100-MIT.txt
!/assets/licenses/silero-vad-MIT.txt
!/assets/licenses/titanet-small-NOTICE.txt
!/assets/licenses/underdog-bark-3.0-pro-NOTICE.txt
!/assets/sounds/
!/assets/sounds/legacy/
!/assets/sounds/minimal-ui/
!/assets/sounds/soft-electronic/
!/assets/sounds/warm-desk/
!/assets/sounds/*/record_start.wav
!/assets/sounds/*/record_stop.wav
!/assets/sounds/*/delivered.wav
!/assets/sounds/*/error.wav
